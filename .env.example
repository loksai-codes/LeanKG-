# Groq (LLM fallback) — https://console.groq.com
GROQ_API_KEY=

# Neo4j (docker compose up -d)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=leankg-dev-pw

# Optional overrides
# LEANKG_LLM_PROVIDER=groq   # uncomment to make every build use Groq; otherwise pass --llm groq
LEANKG_LLM_MODEL=openai/gpt-oss-20b
LEANKG_LLM_BUDGET_CALLS=500
